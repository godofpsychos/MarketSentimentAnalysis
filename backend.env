# Backend Environment Configuration for Local Development
FLASK_ENV=development
FLASK_APP=backend_api.py
FLASK_DEBUG=True

# Base Directory Configuration
BASE_DIR=/home/tarun/MarketSentimentAnalysis
DEVELOPMENT_MODE=True

# Database paths
SENTIMENT_DB_PATH=${BASE_DIR}/Sentiment_Analysis/sentiment_analysis.db
AUTH_DB_PATH=${BASE_DIR}/db/auth.db

# Fundamental Analysis paths
FUNDAMENTAL_BASE_DIR=${BASE_DIR}/FundamentalAnalysis
PROFITABILITY_FILE=${BASE_DIR}/FundamentalAnalysis/outputs/profitability/profitability_ratios.json
VALUATION_FILE=${BASE_DIR}/FundamentalAnalysis/outputs/valuation/basic_valuation_ratios.json
GROWTH_FILE=${BASE_DIR}/FundamentalAnalysis/outputs/growth/revenue_growth.json
LIQUIDITY_FILE=${BASE_DIR}/FundamentalAnalysis/outputs/liquidity/basic_liquidity_ratios.json
CCC_FILE=${BASE_DIR}/FundamentalAnalysis/outputs/liquidity/cash_conversion_cycle.json

# Report and data files
REPORT_CSV_PATH=${BASE_DIR}/report.csv
STOCKS_LIST_PATH=${BASE_DIR}/stocksList.csv

# News and sentiment files
NEWS_JSON_PATH=${BASE_DIR}/news.json
RECENT_NEWS_PATH=${BASE_DIR}/insightGen/recent_news.json
SENTIMENT_RESULTS_PATH=${BASE_DIR}/Sentiment_Analysis/sentiment_analysis_results.json

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=False

# CORS Configuration for Local Development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=${BASE_DIR}/logs/backend.log
ACCESS_LOG_FILE=${BASE_DIR}/logs/access.log
ERROR_LOG_FILE=${BASE_DIR}/logs/error.log 